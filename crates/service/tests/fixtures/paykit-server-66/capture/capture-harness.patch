+    ) -> paykit_sdk::Result<PaymentTarget> {
+        Ok(PaymentTarget {
+            payload: endpoint.payload.clone(),
+        })
+    }
+
+    async fn current_public_receiving_details(
+        &self,
+    ) -> paykit_sdk::Result<Vec<PublicReceivingDetail>> {
+        Ok(Vec::new())
+    }
+
+    async fn select_public_payment_endpoints(
