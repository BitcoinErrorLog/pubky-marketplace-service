# Config-parity list for hold / payment windows.
# Keys must match Config::from_env defaults (crates/service/src/config.rs)
# and the Railway IaC preserve() names in .railway/railway.ts plus
# .railway/railway.staging.ts. Values here are the code defaults. Live
# Railway may still preserve longer FIAT/BITCOIN overrides until ops
# updates them; the service honors any value ≥ 60.
#
# Do not put secrets in this file. Copy to `.env` locally if needed.

# Unbound leftover cancel (ordinary checkout.create does not hold stock).
CHECKOUT_HOLD_WINDOW_SECONDS=900

# PayPal / Stripe bind hold. Default 10 minutes.
FIAT_PAYMENT_WINDOW_SECONDS=600

# Bitcoin bind hold; the same instant is Paykit expires_at.
BITCOIN_PAYMENT_WINDOW_SECONDS=1800

# Locks correlation window IS the hold window.
LOCKS_PAYMENT_WINDOW_SECONDS=3600

# Sandbox lock point (first transition out of awaiting_entitlement).
SANDBOX_PAYMENT_WINDOW_SECONDS=900

# Drop lock-at-claim, still acquired at checkout.create.
DROP_CLAIM_WINDOW_SECONDS=600
